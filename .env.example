# Support Environment Configuration Example

# Logging & Output
SUPPORT_LOG_LEVEL=INFO
SUPPORT_DEBUG=false

# Default Dialect (optional: postgres, mysql, sqlite, mssql)
# SUPPORT_DEFAULT_DIALECT=postgres

# Local Development Docker Databases Configuration
# PostgreSQL
POSTGRES_PORT=5435
POSTGRES_USER=support_dev
POSTGRES_PASSWORD=dev_pg_pass_2026
POSTGRES_DB=support_dev

# MySQL
MYSQL_PORT=3308
MYSQL_ROOT_PASSWORD=dev_root_pass_2026
MYSQL_USER=support_dev
MYSQL_PASSWORD=dev_mysql_pass_2026
MYSQL_DATABASE=support_dev

# Microsoft SQL Server
MSSQL_PORT=1435
MSSQL_SA_PASSWORD=DevPass_2026!

# Saved Connection Profile Secrets Fallback (if keyring is unavailable)
# SUPPORT_DB_PASSWORD_<PROFILE_NAME>=your_password_here
